<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AgentDock.PinPromptWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Agent Dock">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Padding="24" RowSpacing="16" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <Image x:Name="AppIcon" Width="32" Height="32" VerticalAlignment="Center" />
            <TextBlock Text="Pin Agent Dock to the taskbar" Style="{StaticResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock TextWrapping="Wrap"
                       Text="Agent Dock opens from its taskbar icon, so it needs to be pinned there." />
            <TextBlock TextWrapping="Wrap">
                <Run Text="Right-click the Agent Dock icon on the taskbar and choose" />
                <Run Text="Pin to taskbar" FontWeight="SemiBold" /><Run Text=". This window closes once it's pinned." />
            </TextBlock>
        </StackPanel>

        <Button Grid.Row="2" HorizontalAlignment="Right" MinWidth="96" Content="Quit" Click="Quit_Click" />
    </Grid>
</Window>
