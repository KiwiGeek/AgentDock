<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AgentDock.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AgentDock.Models"
    xmlns:local="using:AgentDock"
    Title="Agent Dock">

    <!-- Acrylic: the material Windows 11 uses for its own flyouts. -->
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" PreviewKeyDown="Root_PreviewKeyDown">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" />
        </Grid.RenderTransform>

        <Grid.Resources>
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="16,12,16,4" />
            </Style>

            <DataTemplate x:Key="AgentTemplate" x:DataType="models:AgentItem">
                <!-- Transparent background so the whole row reports the pointer (for the hover background). -->
                <Grid Padding="0,6" ColumnSpacing="12" Opacity="{x:Bind ItemOpacity}" Background="Transparent"
                      PointerEntered="AgentRow_PointerEntered" PointerExited="AgentRow_PointerExited">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="20"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                    <Image Source="{x:Bind Icon, Mode=OneWay}" Width="28" Height="28" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Number key that launches this agent -->
                    <Border Grid.Column="2" MinWidth="22" Height="22" Padding="6,0" CornerRadius="4"
                            VerticalAlignment="Center" BorderThickness="1"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            Visibility="{x:Bind ShortcutVisibility, Mode=OneWay}">
                        <TextBlock Text="{x:Bind Shortcut, Mode=OneWay}" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Border>
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--
            An agent's "background" picture, faded in while the pointer is over that agent. Two layers, so
            moving between agents cross-fades. Size and offset are set in code (LayoutBackdrop) so that,
            with the drawer open, one picture spans both panels. A Canvas, because those pictures are
            larger than the flyout and must not change its height.
        -->
        <Canvas x:Name="HoverBackdrop" Grid.RowSpan="2" IsHitTestVisible="False">
            <Image x:Name="HoverImageA" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill" />
            <Image x:Name="HoverImageB" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill" />
        </Canvas>

        <!--
            The list and the drawer are columns of this one window. The window grows by the drawer's
            width, so the frame, the acrylic and the toolbar are real rather than a second window
            pretending to be attached.
        -->
        <Grid x:Name="Body" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="ListColumn" Width="412">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--
                    Banner, after the Windows 98 Start menu's. Accent colours by default; it takes on the
                    highlighted agent's colour (SetBannerColors). The text reads bottom to top; it's rotated and
                    placed in code (LayoutBanner), since WinUI has no layout transform. A Canvas, so the text's
                    length doesn't affect the flyout's height. The fill is translucent; the text isn't.
                -->
                <Grid x:Name="Banner" SizeChanged="Banner_SizeChanged" AutomationProperties.AccessibilityView="Raw">
                    <Border Opacity="0.7">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                <GradientStop x:Name="BannerStopBottom" Offset="0" />
                                <GradientStop x:Name="BannerStopTop" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Canvas x:Name="BannerCanvas">
                        <TextBlock x:Name="BannerText" FontSize="18" CharacterSpacing="20" TextWrapping="NoWrap">
                            <TextBlock.Foreground>
                                <SolidColorBrush x:Name="BannerTextBrush" />
                            </TextBlock.Foreground>
                            <Run Text="Agent" FontWeight="Bold" /><Run Text=" Dock" FontWeight="SemiLight" />
                        </TextBlock>
                        <!-- Sideways like the text, and beating (StartHearts). -->
                        <TextBlock x:Name="BannerHeart" Text="&#x2764;&#xFE0F;" FontSize="14" Visibility="Collapsed">
                            <TextBlock.RenderTransform>
                                <CompositeTransform x:Name="BannerHeartTransform" Rotation="-90" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Canvas>
                </Grid>

        <Grid x:Name="MainPage" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <!-- Working folder -->
        <StackPanel Grid.Row="0" Margin="16,16,16,8" Spacing="6">
            <TextBlock Text="Working folder" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="FolderBox" HorizontalAlignment="Stretch"
                          SelectionChanged="FolderBox_SelectionChanged"
                          AutomationProperties.Name="Working folder">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:FolderItem">
                            <TextBlock TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}">
                                <Run Text="{x:Bind Name}" />
                                <Run Text="{x:Bind Parent}" FontSize="12"
                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" Height="32" Click="Browse_Click"
                        ToolTipService.ToolTip="Choose folder" AutomationProperties.Name="Choose folder">
                    <FontIcon Glyph="&#xE838;" FontSize="16" />
                </Button>
            </Grid>
        </StackPanel>

        <!-- Agents -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="0,0,0,8">
                <!-- First run, or an empty list: find what's installed (UpdateSetupPanel). -->
                <StackPanel x:Name="SetupPanel" Visibility="Collapsed" Margin="16,12,16,8" Spacing="8">
                    <TextBlock x:Name="SetupTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="SetupText" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button x:Name="FindAgentsButton" Content="Find agents" Style="{StaticResource AccentButtonStyle}"
                                Click="FindAgents_Click" />
                        <Button x:Name="SetupSkipButton" Content="Not now" Click="SetupSkip_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- An agent Agent Dock knows has been installed since; offered, never added by itself. -->
                <InfoBar x:Name="NewAgentOffer" Margin="12,8,12,4" IsOpen="False" Severity="Informational"
                         CloseButtonClick="NewAgentOffer_CloseButtonClick">
                    <InfoBar.ActionButton>
                        <Button x:Name="NewAgentOfferButton" Click="NewAgentOfferButton_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <TextBlock x:Name="PresetHeader" Text="Presets" Style="{StaticResource SectionHeaderStyle}" />
                <ListView x:Name="PresetList" Margin="4,0" SelectionMode="None" IsItemClickEnabled="True"
                          CanReorderItems="True" CanDragItems="True" AllowDrop="True" DragItemsCompleted="AgentList_DragItemsCompleted"
                          ItemClick="Agent_ItemClick" PreviewKeyDown="List_PreviewKeyDown"
                          ContextRequested="Agent_ContextRequested"
                          ItemTemplate="{StaticResource AgentTemplate}"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="Presets" />

                <TextBlock x:Name="CliHeader" Text="Command line" Style="{StaticResource SectionHeaderStyle}" />
                <ListView x:Name="CliList" Margin="4,0" SelectionMode="None" IsItemClickEnabled="True"
                          CanReorderItems="True" CanDragItems="True" AllowDrop="True" DragItemsCompleted="AgentList_DragItemsCompleted"
                          ItemClick="Agent_ItemClick" PreviewKeyDown="List_PreviewKeyDown"
                          ContextRequested="Agent_ContextRequested"
                          ItemTemplate="{StaticResource AgentTemplate}"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="Command line agents" />

                <TextBlock x:Name="DesktopHeader" Text="Desktop apps" Style="{StaticResource SectionHeaderStyle}" />
                <ListView x:Name="DesktopList" Margin="4,0" SelectionMode="None" IsItemClickEnabled="True"
                          CanReorderItems="True" CanDragItems="True" AllowDrop="True" DragItemsCompleted="AgentList_DragItemsCompleted"
                          ItemClick="Agent_ItemClick" PreviewKeyDown="List_PreviewKeyDown"
                          ContextRequested="Agent_ContextRequested"
                          ItemTemplate="{StaticResource AgentTemplate}"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="Desktop apps" />

                <TextBlock x:Name="EmptyText" Visibility="Collapsed" Margin="16,12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="None of your agents are installed. Turn off Hide unavailable agents in settings to see them." />
            </StackPanel>
        </ScrollViewer>
        </Grid>

        <!--
            Settings. Same window as the list, so placement, acrylic and hide-on-deactivate stay as they are.
            Two levels: general settings with the agent list, and below that a page for one agent
            (ShowAgentSettings) or for adding agents (ShowAddAgents). The back button and Esc go up one
            level. The body scrolls, since an agent's page can be longer than the flyout.
        -->
        <Grid x:Name="SettingsPage" Grid.Column="1" Visibility="Collapsed">
            <Grid.Resources>
                <!-- Same borderless buttons as the footer. -->
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Padding="8,12,16,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SettingsBackButton" Width="36" Height="32" Padding="0"
                        Click="SettingsBack_Click"
                        ToolTipService.ToolTip="Back" AutomationProperties.Name="Back">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <TextBlock x:Name="SettingsTitle" Grid.Column="1" Text="Settings" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Style="{StaticResource BodyStrongTextBlockStyle}" />
            </Grid>

            <ScrollViewer x:Name="SettingsScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="0,0,0,8">

            <!-- General settings, and the agent list. -->
            <StackPanel x:Name="SettingsGeneral">
                <TextBlock Text="General" Style="{StaticResource SectionHeaderStyle}" />
                <Grid Margin="16,0,16,16" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Waifu backgrounds" />
                        <TextBlock Text="Show a picture behind the flyout while the pointer is over an agent."
                                   TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="HoverBackgroundsSwitch" Grid.Column="1" MinWidth="0"
                                  VerticalAlignment="Center" OffContent="" OnContent=""
                                  Toggled="HoverBackgroundsSwitch_Toggled"
                                  AutomationProperties.Name="Waifu backgrounds"
                                  AutomationProperties.HelpText="Show a picture behind the flyout while the pointer is over an agent." />
                </Grid>
                <Grid Margin="16,0,16,16" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Hide unavailable agents" />
                        <TextBlock x:Name="HideUnavailableNote" Text="Hide agents in your list that aren't installed any more, instead of showing them dimmed."
                                   TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="HideUnavailableSwitch" Grid.Column="1" MinWidth="0"
                                  VerticalAlignment="Center" OffContent="" OnContent=""
                                  Toggled="HideUnavailableSwitch_Toggled"
                                  AutomationProperties.Name="Hide unavailable agents"
                                  AutomationProperties.HelpText="Hide agents in your list that aren't installed any more, instead of showing them dimmed." />
                </Grid>

                <Grid Margin="16,0,16,16" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Remember recents" />
                        <TextBlock Text="Remember the last five folders you opened each agent in. Right-click one in the drawer to remove it."
                                   TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="RecentFoldersSwitch" Grid.Column="1" MinWidth="0"
                                  VerticalAlignment="Center" OffContent="" OnContent=""
                                  Toggled="RecentFoldersSwitch_Toggled"
                                  AutomationProperties.Name="Remember recents"
                                  AutomationProperties.HelpText="Remember the last five folders you opened each agent in. Right-click one in the drawer to remove it." />
                </Grid>
                <!-- Clears the saved recents (asks first). Disabled when there are none. -->
                <Button x:Name="ClearRecentsButton" Content="Clear recents" Margin="16,-6,16,16"
                        AutomationProperties.HelpText="Forget every recent folder.">
                    <Button.Flyout>
                        <Flyout x:Name="ClearRecentsFlyout">
                            <StackPanel Spacing="12" MaxWidth="260">
                                <TextBlock Text="Forget every recent folder?" TextWrapping="Wrap" />
                                <Button Content="Clear" Style="{StaticResource AccentButtonStyle}" Click="ClearRecents_Click" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Your agents, in the order they appear (BuildAgentSettingsRows), and a way to add more. -->
                <TextBlock Text="Agents" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock x:Name="AgentListNote" Margin="16,0,16,4" TextWrapping="Wrap" Visibility="Collapsed"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <!-- Click for the agent's page; drag to reorder (the flyout follows). -->
                <ListView x:Name="AgentSettingsList" Margin="4,0,4,4" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="AgentSettingsList_ItemClick"
                          CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                          DragItemsCompleted="AgentSettingsList_DragItemsCompleted"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="Your agents">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:AgentListRow">
                            <Grid Padding="0,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Visibility="{x:Bind GlyphVisibility}" />
                                <Image Source="{x:Bind Icon}" Width="24" Height="24" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Note}" Visibility="{x:Bind NoteVisibility}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="AddAgentsButtons" Margin="8,0,8,12" Spacing="2">
                    <Button x:Name="ScanAgentsButton" Padding="8,6" Click="AddAgents_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            AutomationProperties.Name="Scan for new agents">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE721;" FontSize="16" Width="24" />
                            <TextBlock Text="Scan for new agents" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AddCustomAgentButton" Padding="8,6" Click="AddCustomAgent_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            AutomationProperties.Name="Add your own command">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE710;" FontSize="16" Width="24" />
                            <TextBlock Text="Add your own command" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Adding agents: what a scan found, and a command of your own. -->
            <StackPanel x:Name="AddAgentsPage" Visibility="Collapsed">
                <TextBlock Text="Found on this PC" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock x:Name="FoundAgentsNote" Margin="16,0,16,4" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel x:Name="FoundAgentsList" Margin="16,0,16,4" Spacing="0" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,4,16,16">
                    <Button x:Name="AddFoundButton" Content="Add selected"
                            Style="{StaticResource AccentButtonStyle}" Click="AddFound_Click" />
                    <Button x:Name="ScanAgainButton" Click="ScanAgain_Click" AutomationProperties.Name="Scan again">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Scan again" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Text="Your own command" Style="{StaticResource SectionHeaderStyle}" />
                <StackPanel Margin="16,0,16,16" Spacing="8">
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Any command line tool, started in a terminal in the working folder." />
                    <TextBox x:Name="CustomNameBox" Header="Name" PlaceholderText="My agent" />
                    <TextBox x:Name="CustomCommandBox" Header="Command" PlaceholderText="my-agent" />
                    <TextBox x:Name="CustomArgumentsBox" Header="Arguments (optional)" />
                    <Button x:Name="AddCustomButton" Content="Add" Click="AddCustom_Click" />
                    <TextBlock x:Name="CustomNote" Visibility="Collapsed" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- One agent's page (ShowAgentSettings): name, arguments, variables, place in the list. -->
            <StackPanel x:Name="AgentEditor" Visibility="Collapsed">
                <StackPanel Margin="16,12,16,12" Spacing="8">
                    <TextBox x:Name="AgentNameBox" Header="Name" LostFocus="AgentNameBox_LostFocus" KeyDown="EditorBox_KeyDown" />
                    <TextBox x:Name="AgentArgumentsBox" Header="Arguments" LostFocus="AgentArgumentsBox_LostFocus" KeyDown="EditorBox_KeyDown" />
                    <TextBlock x:Name="AgentCommandText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel x:Name="AgentEnvSection">
                    <TextBlock Text="Environment variables" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock x:Name="AgentEnvNote" Margin="16,0,16,8" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel x:Name="AgentEnvRows" Margin="16,0,8,4" Spacing="2" />
                    <Grid Margin="16,4,16,16" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="EnvNameBox" PlaceholderText="Name" AutomationProperties.Name="Variable name"
                                 KeyDown="EnvBox_KeyDown" />
                        <TextBox x:Name="EnvValueBox" Grid.Column="1" PlaceholderText="Value" AutomationProperties.Name="Variable value"
                                 KeyDown="EnvBox_KeyDown" />
                        <Button Grid.Column="2" Width="36" Height="32" Padding="0" Click="AddEnv_Click"
                                ToolTipService.ToolTip="Add variable" AutomationProperties.Name="Add variable">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                        </Button>
                    </Grid>
                </StackPanel>

                <TextBlock Text="In your list" Style="{StaticResource SectionHeaderStyle}" />
                <StackPanel Margin="8,0,8,12" Spacing="2">
                    <Button Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="DuplicateAgent_Click"
                            AutomationProperties.HelpText="A second copy with its own name and variables, e.g. for another account.">
                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8C8;" FontSize="16" Width="24" /><TextBlock Text="Duplicate" /></StackPanel>
                    </Button>
                    <Button Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE74D;" FontSize="16" Width="24" /><TextBlock Text="Remove" /></StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="RemoveAgentFlyout">
                                <StackPanel Spacing="12" MaxWidth="260">
                                    <TextBlock x:Name="RemoveAgentText" TextWrapping="Wrap" />
                                    <Button Content="Remove" Style="{StaticResource AccentButtonStyle}" Click="RemoveAgent_Click" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Shown under Grok Build's page: its usage comes from grok.com, in Agent Dock's own sign-in. -->
            <StackPanel x:Name="GrokSettings" Visibility="Collapsed">
                <TextBlock Text="Usage limits" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock Margin="16,0,16,8" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Grok Build's usage comes from grok.com, through a sign-in that stays with Agent Dock. Open grok.com to sign in, sign out or switch accounts. This is not a published xAI API, and it can stop working." />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,16,8">
                    <Button Content="Open grok.com" Click="OpenGrok_Click" />
                    <!-- Clears Agent Dock's own grok.com profile (asks first). Disabled before the first sign-in. -->
                    <Button x:Name="GrokSignOutButton" Content="Sign out"
                            AutomationProperties.HelpText="Sign Agent Dock out of grok.com. Your browser stays signed in.">
                        <Button.Flyout>
                            <Flyout x:Name="GrokSignOutFlyout">
                                <StackPanel Spacing="12" MaxWidth="260">
                                    <TextBlock TextWrapping="Wrap"
                                               Text="Sign Agent Dock out of grok.com? Grok usage won't show until you sign in again. Your browser and Grok Build stay signed in." />
                                    <Button Content="Sign out" Style="{StaticResource AccentButtonStyle}" Click="GrokSignOut_Click" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="GrokSignOutNote" Margin="16,0,16,16" Visibility="Collapsed" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Shown under the agent's page for Claude Code (and its copies). -->
            <StackPanel x:Name="ClaudeSettings" Visibility="Collapsed">
                <TextBlock Text="Usage limits" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock x:Name="ClaudeUsageIntro" Margin="16,0,16,4" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="How Agent Dock finds out how much of your plan's session and weekly limits you've used, for the drawer beside Claude Code." />
                <RadioButtons x:Name="ClaudeUsageSourceButtons" Margin="16,0,16,12"
                              SelectionChanged="ClaudeUsageSource_SelectionChanged"
                              AutomationProperties.Name="How to check Claude usage limits"
                              AutomationProperties.HelpText="How Agent Dock finds out how much of your plan's session and weekly limits you've used, for the drawer beside Claude Code.">
                    <RadioButton AutomationProperties.Name="Read them from the status line"
                                 AutomationProperties.HelpText="Claude Code reports your limits while a session is running.">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Read them from the status line" />
                            <TextBlock Text="Claude Code reports your limits while a session is running."
                                       TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton AutomationProperties.Name="Ask Claude for them directly"
                                 AutomationProperties.HelpText="Checks your limits when you open the flyout, using the Claude Code sign-in already on this PC. This is not a published Anthropic API, and it can stop working.">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Ask Claude for them directly" />
                            <TextBlock Text="Checks your limits when you open the flyout, using the Claude Code sign-in already on this PC. This is not a published Anthropic API, and it can stop working."
                                       TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </RadioButton>
                </RadioButtons>
            </StackPanel>

            </StackPanel>
            </ScrollViewer>
        </Grid>
            </Grid>

            <!--
                Grows from the list. Its width is animated; the window size follows (DrawerHost_SizeChanged).
                Content sits against the list, so the growing window uncovers it.
            -->
            <!--
                Transparent backgrounds are what make the empty parts of the column hit-testable.
                Without them, moving off the usage or a recent folder counts as leaving the sidebar.
            -->
            <Border x:Name="DrawerHost" Grid.Column="1" Width="0" Visibility="Collapsed"
                    Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    SizeChanged="DrawerHost_SizeChanged"
                    PointerEntered="Drawer_PointerEntered" PointerExited="Drawer_PointerExited">
                <StackPanel x:Name="DrawerPanel" Width="240" Background="Transparent"
                            HorizontalAlignment="Left" VerticalAlignment="Stretch">
                <Grid>
                    <!-- Plan usage for the hovered agent (Services/ClaudeStatusLine.cs, CodexUsage.cs, CopilotUsage.cs) -->
                    <StackPanel x:Name="UsagePanel" Padding="16,16,16,12" Spacing="4" Visibility="Collapsed">
                        <TextBlock x:Name="UsageTitle" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <!-- The plan (Codex) or the last model used (Claude), when known. -->
                        <TextBlock x:Name="UsageSubtitle" Visibility="Collapsed" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <StackPanel x:Name="UsageRows" Spacing="2" Margin="0,8,0,0">
                            <!-- "Session" and "Week" for Claude Code and Codex; Copilot uses only the first row. -->
                            <TextBlock x:Name="SessionLabel" Text="Session" />
                            <ProgressBar x:Name="SessionBar" Maximum="100" AutomationProperties.Name="Session usage" />
                            <TextBlock x:Name="SessionText" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="WeekGroup" Spacing="2" Margin="0,6,0,0">
                                <TextBlock Text="Week" />
                                <ProgressBar x:Name="WeekBar" Maximum="100" AutomationProperties.Name="Weekly usage" />
                                <TextBlock x:Name="WeekText" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <!-- Per-model weeks (Claude: Sonnet, Opus), filled in ShowUsageExtras. -->
                            <StackPanel x:Name="ModelWeekRows" Spacing="2" />
                            <!-- Claude's extra usage, or Codex's credits. -->
                            <TextBlock x:Name="ExtraUsageText" Visibility="Collapsed" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <!-- What the usage went on (Grok: Imagine, Cursor, Grok Build…): a pie and its legend (ShowBreakdown). -->
                            <StackPanel x:Name="BreakdownChart" Visibility="Collapsed" Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
                                <Canvas x:Name="BreakdownPie" Width="64" Height="64" VerticalAlignment="Center"
                                        AutomationProperties.Name="What this week's usage went on" />
                                <StackPanel x:Name="BreakdownLegend" Spacing="1" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="UsageUpdatedText" Margin="0,8,0,0" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="UsageNote" Visibility="Collapsed" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <InfoBar x:Name="UsageOffer" Margin="8" VerticalAlignment="Top" IsOpen="False" Title="Claude usage"
                             CloseButtonClick="UsageOffer_CloseButtonClick">
                        <InfoBar.ActionButton>
                            <Button x:Name="UsageOfferButton" Click="UsageOfferButton_Click" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </Grid>

                    <!-- Claude Code and Codex (ShowRecents). -->
                    <StackPanel x:Name="RecentSection" Visibility="Collapsed" Padding="8,0,8,12" Spacing="2">
                        <StackPanel.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Default">
                                        <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                        <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Light">
                                        <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                        <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </StackPanel.Resources>
                        <TextBlock Text="Recent folders" Margin="8,8,8,4" Style="{StaticResource CaptionTextBlockStyle}"
                                   FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel x:Name="RecentRows" Spacing="2" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!--
            The bar and its divider span the whole window, including the drawer. The buttons stay in the
            list's width (FooterContent), so growing the window doesn't carry them along.
        -->
        <Border x:Name="FooterBar" Grid.Row="1" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
            <!-- Left padding lines the status text up with the list, past the banner. -->
            <Grid x:Name="FooterContent" Width="412" HorizontalAlignment="Left" Padding="48,6,8,6" ColumnSpacing="4">
                <Grid.Resources>
                    <!-- Lightweight styling: borderless buttons, like the Start menu's footer. -->
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Default">
                                <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Light">
                                <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Grid.Column="1" Width="36" Height="32" Padding="0" Click="OpenShell_Click"
                        ToolTipService.ToolTip="Open terminal in this folder"
                        AutomationProperties.Name="Open terminal in this folder">
                    <FontIcon Glyph="&#xE756;" FontSize="16" />
                </Button>
                <Button Grid.Column="2" Width="36" Height="32" Padding="0" Click="EditAgents_Click"
                        ToolTipService.ToolTip="Edit agents" AutomationProperties.Name="Edit agents">
                    <FontIcon Glyph="&#xE70F;" FontSize="16" />
                </Button>
                <Button Grid.Column="3" Width="36" Height="32" Padding="0" Click="Settings_Click"
                        ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </Grid>
        </Border>

        <!--
            Drag to change the flyout's height (list and settings alike); double-click to fit the list again. On the edge away from
            the taskbar (set in PlaceWindow). Last, so it's on top of everything else. Settings uses the same height.
        -->
        <local:ResizeGrip x:Name="HeightGrip" Grid.RowSpan="2" Height="6" VerticalAlignment="Top"
                          PointerPressed="HeightGrip_PointerPressed" PointerMoved="HeightGrip_PointerMoved"
                          PointerReleased="HeightGrip_PointerReleased" PointerCaptureLost="HeightGrip_PointerCaptureLost"
                          DoubleTapped="HeightGrip_DoubleTapped"
                          ToolTipService.ToolTip="Drag to resize. Double-click to fit." />
    </Grid>
</Window>
