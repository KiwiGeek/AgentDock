<?xml version="1.0" encoding="utf-8"?>
<!--
    Agent Dock's settings: master-detail. The left list is General, Accounts, each agent (drag to
    reorder), and Add agents. The right pane shows only that item's details; an API key's page opens
    from Accounts, with Accounts above its title to go back. Esc closes the window.
-->
<Window
    x:Class="AgentDock.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AgentDock.Models"
    Title="Agent Dock settings">

    <Window.SystemBackdrop>
        <!-- BaseAlt: the stronger tint, so the wallpaper's colour reads through more (owner's request, 2026-10-20). -->
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" PreviewKeyDown="Root_PreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <!-- Borderless buttons, as the flyout's footer has them. -->
                    <ResourceDictionary x:Key="Default">
                        <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                        <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                        <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>

                <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Setter Property="Margin" Value="0,12,0,8" />
                </Style>
                <Style x:Key="NoteTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <!--
            The title bar is part of the window's content (ExtendsContentIntoTitleBar), on the same
            Mica as the left list, as in Windows' own Settings. The caption buttons draw over its right end.
        -->
        <Grid x:Name="AppTitleBar" Height="48" ColumnSpacing="12" Padding="16,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="AppTitleIcon" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock x:Name="AppTitleText" Grid.Column="1" Text="Agent Dock settings" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!--
            Left list is hand-built so agents can be dragged to reorder (NavigationView can't).
            Agents are filled in code; the other rows are fixed.
        -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- No fill: the left list sits straight on the Mica. -->
            <Border Grid.Column="0" Background="Transparent" AutomationProperties.Name="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="4,8,4,8">
                        <ListView x:Name="GeneralNav" SelectionMode="Single"
                                  SelectionChanged="StaticNav_SelectionChanged"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListViewItem x:Name="GeneralNavItem" Tag="general" Padding="12,8"
                                          AutomationProperties.Name="General">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE713;" FontSize="16" Width="20" />
                                    <TextBlock Text="General" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem x:Name="AccountsNavItem" Tag="accounts" Padding="12,8"
                                          AutomationProperties.Name="Accounts">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE8D7;" FontSize="16" Width="20" />
                                    <TextBlock Text="Accounts" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListViewItem>
                        </ListView>

                        <TextBlock Text="Agents" Margin="12,12,12,4"
                                   Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <ListView x:Name="AgentNavList" SelectionMode="Single"
                                  CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                                  DragItemsCompleted="AgentNav_DragItemsCompleted"
                                  SelectionChanged="AgentNav_SelectionChanged"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="Agents">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:AgentListRow">
                                    <Grid Padding="0,2" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Width="16" Height="16" VerticalAlignment="Center"
                                               Source="{x:Bind Icon}" Stretch="Uniform"
                                               Visibility="{x:Bind IconVisibility}" />
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16"
                                                  VerticalAlignment="Center"
                                                  Visibility="{x:Bind GlyphVisibility}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Note}" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{x:Bind NoteVisibility}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <ListView x:Name="AddAgentsNav" SelectionMode="Single"
                                  SelectionChanged="StaticNav_SelectionChanged"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListViewItem x:Name="AddAgentsNavItem" Tag="add-agents" Padding="12,8"
                                          AutomationProperties.Name="Add agents">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE710;" FontSize="16" Width="20" />
                                    <TextBlock Text="Add agents" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListViewItem>
                        </ListView>

                        <!-- Last, as in Windows' own Settings. -->
                        <ListView x:Name="AboutNav" SelectionMode="Single" Margin="0,12,0,0"
                                  SelectionChanged="StaticNav_SelectionChanged"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListViewItem x:Name="AboutNavItem" Tag="about" Padding="12,8"
                                          AutomationProperties.Name="About">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE946;" FontSize="16" Width="20" />
                                    <TextBlock Text="About" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListViewItem>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- The page sits on a lighter layer over the Mica, its top-left corner rounded. -->
            <Grid Grid.Column="1"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The agent's waifu picture, behind her settings page (only while waifus are on). -->
                <Image x:Name="AgentBackdrop" Grid.RowSpan="2" Stretch="UniformToFill"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Opacity="0.3" IsHitTestVisible="False" Visibility="Collapsed" />

                <!--
                    The About page's slideshow while waifus are on: every built-in picture in turn, each
                    fading in over the last while it slowly zooms and pans. Two layers take turns; the
                    clip (set in code) keeps the zoom inside the pane.
                -->
                <Grid x:Name="AboutSlides" Grid.RowSpan="2" IsHitTestVisible="False" Visibility="Collapsed"
                      SizeChanged="AboutSlides_SizeChanged">
                    <Image x:Name="AboutSlideA" Stretch="Fill" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Image.RenderTransform><CompositeTransform /></Image.RenderTransform>
                    </Image>
                    <Image x:Name="AboutSlideB" Stretch="Fill" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Image.RenderTransform><CompositeTransform /></Image.RenderTransform>
                    </Image>
                </Grid>

                <!-- The page's title; an API key's page has Accounts in front of it, to go back. -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="24,16,24,0">
                    <HyperlinkButton x:Name="AccountsCrumb" Content="Accounts" Padding="0" Visibility="Collapsed"
                                     FontSize="20" FontWeight="SemiBold" Click="AccountsCrumb_Click"
                                     AutomationProperties.Name="Back to accounts" />
                    <FontIcon x:Name="AccountsCrumbChevron" Glyph="&#xE76C;" FontSize="12" Visibility="Collapsed"
                              VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="SettingsTitle" Text="General" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>

                <ScrollViewer x:Name="SettingsScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Padding="24,8,24,24">
                    <!--
                        Pages fill the pane up to 1000 DIP, left-aligned, as Windows' own Settings does,
                        so a row's switch stays at the row's end. A star column with a MaxWidth gives that;
                        Stretch with a MaxWidth would centre the page instead.
                    -->
                    <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1000" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>

                    <!-- General: the flyout, the taskbar icon, launching, recent folders. -->
                    <StackPanel x:Name="GeneralPage">
                        <TextBlock Text="Flyout" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,16" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Usage overview" />
                                <TextBlock Text="Show every agent's usage beside the list while the pointer isn't over one, to help pick an agent."
                                           Style="{StaticResource NoteTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="UsageSummarySwitch" Grid.Column="1" MinWidth="0"
                                          VerticalAlignment="Center" OffContent="" OnContent=""
                                          Toggled="UsageSummarySwitch_Toggled"
                                          AutomationProperties.Name="Usage overview"
                                          AutomationProperties.HelpText="Show every agent's usage beside the list while the pointer isn't over one, to help pick an agent." />
                        </Grid>
                        <Grid Margin="0,0,0,16" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Hide unavailable agents" />
                                <TextBlock x:Name="HideUnavailableNote" Text="Hide agents in your list that aren't installed any more, instead of showing them dimmed."
                                           Style="{StaticResource NoteTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="HideUnavailableSwitch" Grid.Column="1" MinWidth="0"
                                          VerticalAlignment="Center" OffContent="" OnContent=""
                                          Toggled="HideUnavailableSwitch_Toggled"
                                          AutomationProperties.Name="Hide unavailable agents"
                                          AutomationProperties.HelpText="Hide agents in your list that aren't installed any more, instead of showing them dimmed." />
                        </Grid>
                        <!-- Waifu backgrounds: hidden until it's unlocked from About, so a fresh install never sees it. -->
                        <Grid x:Name="HoverBackgroundsRow" Margin="0,0,0,16" ColumnSpacing="12" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Waifu backgrounds" />
                                <TextBlock Text="Show a picture behind the flyout while the pointer is over an agent."
                                           Style="{StaticResource NoteTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="HoverBackgroundsSwitch" Grid.Column="1" MinWidth="0"
                                          VerticalAlignment="Center" OffContent="" OnContent=""
                                          Toggled="HoverBackgroundsSwitch_Toggled"
                                          AutomationProperties.Name="Waifu backgrounds"
                                          AutomationProperties.HelpText="Show a picture behind the flyout while the pointer is over an agent." />
                        </Grid>
                        <!-- Her picture inside the tools themselves; needs Waifu backgrounds on, so it hides with them. -->
                        <Grid x:Name="WaifuInAppsRow" Margin="0,0,0,16" ColumnSpacing="12" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Waifu in terminals and Harness" />
                                <TextBlock Text="Show her picture behind CLI tabs and in DeepSeek Harness."
                                           Style="{StaticResource NoteTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="WaifuInAppsSwitch" Grid.Column="1" MinWidth="0"
                                          VerticalAlignment="Center" OffContent="" OnContent=""
                                          Toggled="WaifuInAppsSwitch_Toggled"
                                          AutomationProperties.Name="Waifu in terminals and Harness"
                                          AutomationProperties.HelpText="Show her picture behind CLI tabs and in DeepSeek Harness. The rest of waifu mode isn't affected." />
                        </Grid>

                        <TextBlock Text="Taskbar icon" Style="{StaticResource SectionHeaderStyle}" />
                        <StackPanel Margin="0,0,0,16" Spacing="8">
                            <TextBlock x:Name="TaskbarIconNote" Style="{StaticResource NoteTextStyle}" />
                            <GridView x:Name="TaskbarIconPicker" SelectionMode="Single" SingleSelectionFollowsFocus="False" Margin="-4,0"
                                      SelectionChanged="TaskbarIconPicker_SelectionChanged"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      AutomationProperties.Name="Taskbar icon">
                                <GridView.ItemContainerStyle>
                                    <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                                        <Setter Property="Margin" Value="2" />
                                        <Setter Property="Padding" Value="4" />
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </GridView.ItemContainerStyle>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="models:TaskbarIconChoice">
                                        <Image Source="{x:Bind Preview}" Width="36" Height="36"
                                               ToolTipService.ToolTip="{x:Bind Name}"
                                               AutomationProperties.Name="{x:Bind Name}" />
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                            <InfoBar x:Name="TaskbarIconRestartBar" IsOpen="False" Severity="Informational" IsClosable="True"
                                     Title="Restart File Explorer to see it"
                                     Message="Windows shows the new icon after File Explorer restarts, or the next time you sign in. Restarting closes any open File Explorer windows.">
                                <InfoBar.ActionButton>
                                    <Button x:Name="TaskbarIconRestartButton" Content="Restart now" Click="TaskbarIconRestart_Click" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                        </StackPanel>

                        <TextBlock Text="Launching" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid Margin="0,0,0,16" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Terminal" />
                                <TextBlock Text="Where command line agents open." Style="{StaticResource NoteTextStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="TerminalBox" Grid.Column="1" MinWidth="220" VerticalAlignment="Center"
                                      SelectionChanged="TerminalBox_SelectionChanged" AutomationProperties.Name="Terminal" />
                        </Grid>
                        <Grid Margin="0,0,0,16" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Shell" />
                                <TextBlock Text="The shell command line agents run in. An agent can have its own in agents.json." Style="{StaticResource NoteTextStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="ShellBox" Grid.Column="1" MinWidth="220" VerticalAlignment="Center"
                                      SelectionChanged="ShellBox_SelectionChanged" AutomationProperties.Name="Shell" />
                        </Grid>
                        <Grid Margin="0,0,0,16" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Close terminal when agent exits" />
                                <TextBlock Text="Close Agent Dock's terminal tab when a command line agent finishes, instead of leaving a prompt."
                                           Style="{StaticResource NoteTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CloseTerminalOnExitSwitch" Grid.Column="1" MinWidth="0" VerticalAlignment="Center" OffContent="" OnContent=""
                                          Toggled="CloseTerminalOnExitSwitch_Toggled" AutomationProperties.Name="Close terminal when agent exits" />
                        </Grid>
                        <Grid Margin="0,0,0,16" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Start with Windows" />
                                <TextBlock Text="Start hidden when you sign in, so the first click of the day is as fast as the rest."
                                           Style="{StaticResource NoteTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StartWithWindowsSwitch" Grid.Column="1" MinWidth="0" VerticalAlignment="Center" OffContent="" OnContent=""
                                          Toggled="StartWithWindowsSwitch_Toggled" AutomationProperties.Name="Start with Windows" />
                        </Grid>

                        <TextBlock Text="Recent folders" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid Margin="0,0,0,16" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Remember recents" />
                                <TextBlock Text="Remember the last five folders you opened each agent in. Right-click one in the drawer to remove it."
                                           Style="{StaticResource NoteTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="RecentFoldersSwitch" Grid.Column="1" MinWidth="0"
                                          VerticalAlignment="Center" OffContent="" OnContent=""
                                          Toggled="RecentFoldersSwitch_Toggled"
                                          AutomationProperties.Name="Remember recents"
                                          AutomationProperties.HelpText="Remember the last five folders you opened each agent in. Right-click one in the drawer to remove it." />
                        </Grid>
                        <Button x:Name="ClearRecentsButton" Content="Clear recents" Margin="0,-6,0,0"
                                AutomationProperties.HelpText="Forget every recent folder.">
                            <Button.Flyout>
                                <Flyout x:Name="ClearRecentsFlyout">
                                    <StackPanel Spacing="12" MaxWidth="260">
                                        <TextBlock Text="Forget every recent folder?" TextWrapping="Wrap" />
                                        <Button Content="Clear" Style="{StaticResource AccentButtonStyle}" Click="ClearRecents_Click" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <!-- Accounts: every plan sign-in and API key, and which agents use each. Rows are built in code. -->
                    <StackPanel x:Name="AccountsPage" Visibility="Collapsed">
                        <TextBlock Margin="0,0,0,4" Style="{StaticResource NoteTextStyle}"
                                   Text="The sign-ins and API keys your agents run on. Add a key once, then link it to every agent that can use it." />

                        <TextBlock Text="Plans" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock x:Name="PlansNote" Margin="0,0,0,8" Style="{StaticResource NoteTextStyle}" />
                        <StackPanel x:Name="PlansHost" Spacing="4" />

                        <Grid Margin="0,16,0,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="API keys" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                                <TextBlock Style="{StaticResource NoteTextStyle}"
                                           Text="Agent Dock hands a key to each agent linked to it, as the variable that agent reads." />
                            </StackPanel>
                            <Button x:Name="AddApiKeyButton" Grid.Column="1" VerticalAlignment="Center"
                                    Style="{StaticResource AccentButtonStyle}" Click="AddApiKey_Click" AutomationProperties.Name="Add a key">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="Add a key" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="ApiKeysNote" Margin="0,0,0,8" Style="{StaticResource NoteTextStyle}" Visibility="Collapsed"
                                   Text="No API keys yet. Add one for agents that run on a key, like Aider or OpenCode." />
                        <StackPanel x:Name="ApiKeysHost" Spacing="4" />

                        <Grid Margin="0,20,0,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Suggest plans before API keys" />
                                <TextBlock Text="The usage overview suggests an agent on an API key only once no agent on a plan has room left."
                                           Style="{StaticResource NoteTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="PreferPlansSwitch" Grid.Column="1" MinWidth="0"
                                          VerticalAlignment="Center" OffContent="" OnContent=""
                                          Toggled="PreferPlansSwitch_Toggled"
                                          AutomationProperties.Name="Suggest plans before API keys"
                                          AutomationProperties.HelpText="The usage overview suggests an agent on an API key only once no agent on a plan has room left." />
                        </Grid>
                        <TextBlock Style="{StaticResource NoteTextStyle}"
                                   Text="Keys are saved in agents.json as you type them. Type %NAME% instead to read one from Windows." />
                    </StackPanel>

                    <!--
                        About (issue #4), laid out like Windows' Settings > System > About: what's running,
                        updates, links, where the data lives, and the licence. Filled in code (ShowAbout).
                    -->
                    <StackPanel x:Name="AboutPage" Visibility="Collapsed" Spacing="4">
                        <StackPanel.Resources>
                            <Style x:Key="AboutCardStyle" TargetType="Grid">
                                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                                <Setter Property="Padding" Value="16,12" />
                                <Setter Property="MinHeight" Value="64" />
                                <Setter Property="ColumnSpacing" Value="16" />
                            </Style>
                            <Style x:Key="AboutLinkStyle" TargetType="Button">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="16,12" />
                                <Setter Property="MinHeight" Value="56" />
                                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                            </Style>
                        </StackPanel.Resources>

                        <!-- What's running. -->
                        <Grid Style="{StaticResource AboutCardStyle}" Padding="20" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image x:Name="AboutIcon" Width="64" Height="64" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Agent Dock" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <!-- A transparent strip behind the version: its seven clicks are the hidden unlock. -->
                                <Border x:Name="AboutVersionArea" Background="Transparent" HorizontalAlignment="Left"
                                        PointerPressed="AboutVersion_PointerPressed">
                                    <TextBlock x:Name="AboutVersion" />
                                </Border>
                                <TextBlock x:Name="AboutCopyKind" Style="{StaticResource NoteTextStyle}" />
                            </StackPanel>
                            <Button x:Name="AboutCopyButton" Grid.Column="2" VerticalAlignment="Center"
                                    Click="AboutCopy_Click" AutomationProperties.Name="Copy version details"
                                    ToolTipService.ToolTip="Copy the version and Windows details, for a bug report">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon x:Name="AboutCopyGlyph" Glyph="&#xE8C8;" FontSize="14" />
                                    <TextBlock x:Name="AboutCopyText" Text="Copy" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Hidden until waifu mode is found: its text comes from SyncUnlockNote. -->
                        <TextBlock x:Name="AboutUnlockedNote" Visibility="Collapsed" Margin="0,0,0,4"
                                   Style="{StaticResource NoteTextStyle}" TextWrapping="Wrap" />

                        <TextBlock Text="Updates" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid Style="{StaticResource AboutCardStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="24" VerticalAlignment="Center">
                                <FontIcon x:Name="UpdateGlyph" Glyph="&#xE895;" FontSize="20" />
                                <ProgressRing x:Name="UpdateRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="UpdateTitle" TextWrapping="Wrap" />
                                <TextBlock x:Name="UpdateDetail" Style="{StaticResource NoteTextStyle}" />
                                <ProgressBar x:Name="UpdateProgress" Margin="0,6,0,0" Maximum="100" Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdates_Click" />
                                <Button x:Name="RestartUpdateButton" Content="Restart now" Visibility="Collapsed"
                                        Style="{StaticResource AccentButtonStyle}" Click="RestartUpdate_Click"
                                        AutomationProperties.HelpText="Closes Agent Dock, applies the update and starts it again." />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Links" Style="{StaticResource SectionHeaderStyle}" />
                        <Button Style="{StaticResource AboutLinkStyle}" Tag="repo" Click="AboutLink_Click" AutomationProperties.Name="GitHub repository">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE943;" FontSize="18" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="GitHub repository" />
                                    <TextBlock Text="The source code, and every release." Style="{StaticResource NoteTextStyle}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource AboutLinkStyle}" Tag="notes" Click="AboutLink_Click" AutomationProperties.Name="Release notes">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8A5;" FontSize="18" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock x:Name="ReleaseNotesTitle" Text="Release notes" />
                                    <TextBlock Text="What changed in this version." Style="{StaticResource NoteTextStyle}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource AboutLinkStyle}" Tag="issue" Click="AboutLink_Click" AutomationProperties.Name="Report an issue">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEBE8;" FontSize="18" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Report an issue" />
                                    <TextBlock Text="Something broken or missing. Copy above puts the version details on the clipboard to paste in." Style="{StaticResource NoteTextStyle}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>

                        <TextBlock Text="Where your data lives" Style="{StaticResource SectionHeaderStyle}" />
                        <StackPanel x:Name="AboutFoldersHost" Spacing="4" />

                        <TextBlock Text="Licence and credits" Style="{StaticResource SectionHeaderStyle}" />
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <Grid ColumnSpacing="16" Padding="0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE82D;" FontSize="18" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="GNU General Public License, version 3 or later" />
                                        <TextBlock Text="Free software: use it, change it and share it, and keep it free when you do." Style="{StaticResource NoteTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="12" Padding="40,0,0,0">
                                <TextBlock TextWrapping="Wrap"
                                           Text="Agent Dock is distributed in the hope that it will be useful, but without any warranty; see the licence for details." />
                                <HyperlinkButton Content="Read the licence" Tag="licence" Click="AboutLink_Click" Padding="0" />
                                <TextBlock Text="Built with" Style="{StaticResource SectionHeaderStyle}" Margin="0,4,0,0" />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource NoteTextStyle}"
                                           Text="The Windows App SDK and WinUI 3, and .NET with Native AOT, both from Microsoft under the MIT licence. Velopack, for installing and updating, under the MIT licence." />
                                <TextBlock Text="Trademarks" Style="{StaticResource SectionHeaderStyle}" Margin="0,4,0,0" />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource NoteTextStyle}"
                                           Text="Agent names and logos, including those in the pictures, belong to their owners. They're here only to show which agent is which, and the licence grants no rights to them. Agent Dock isn't made or endorsed by any of them." />
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- One API account (opened from Accounts). Built in code. -->
                    <StackPanel x:Name="ApiPage" Visibility="Collapsed">
                        <StackPanel x:Name="ApiAccountHost" />
                    </StackPanel>

                    <!-- Add agents (scan and a command of your own). -->
                    <StackPanel x:Name="AddAgentsPage" Visibility="Collapsed">
                        <TextBlock x:Name="AgentListNote" Margin="0,0,0,12" Visibility="Collapsed" Style="{StaticResource NoteTextStyle}" />
                        <TextBlock Text="Found on this PC" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8" />
                        <TextBlock x:Name="FoundAgentsNote" Margin="0,0,0,8" Style="{StaticResource NoteTextStyle}" />
                        <StackPanel x:Name="FoundAgentsList" Margin="0,0,0,4" Spacing="0" />
                        <Expander x:Name="MissingAgentsExpander" Visibility="Collapsed" Margin="0,4,0,4"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <StackPanel Padding="0,6">
                                    <TextBlock x:Name="MissingAgentsTitle" Text="Not found on this PC" />
                                    <TextBlock Style="{StaticResource NoteTextStyle}"
                                               Text="Add one anyway if it's installed somewhere Agent Dock doesn't look, or you're about to install it." />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel x:Name="MissingAgentsList" Spacing="0" />
                        </Expander>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,16">
                            <Button x:Name="AddFoundButton" Content="Add selected"
                                    Style="{StaticResource AccentButtonStyle}" Click="AddFound_Click" />
                            <Button x:Name="ScanAgainButton" Click="ScanAgain_Click" AutomationProperties.Name="Scan again">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="Scan again" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="Your own command" Style="{StaticResource SectionHeaderStyle}" />
                        <!-- A short form: its text boxes would look odd 1000 DIP wide. -->
                        <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="560" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource NoteTextStyle}"
                                       Text="Any command line tool, started in a terminal in the working folder." />
                            <TextBox x:Name="CustomNameBox" Header="Name" PlaceholderText="My agent" />
                            <TextBox x:Name="CustomCommandBox" Header="Command" PlaceholderText="my-agent" />
                            <TextBox x:Name="CustomArgumentsBox" Header="Arguments (optional)" />
                            <Button x:Name="AddCustomButton" Content="Add" Click="AddCustom_Click" />
                            <TextBlock x:Name="CustomNote" Visibility="Collapsed" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- One agent's page (Agents sub-page): its account first, then how it launches. -->
                    <StackPanel x:Name="AgentEditor" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBox x:Name="AgentNameBox" Header="Name" LostFocus="AgentNameBox_LostFocus" KeyDown="EditorBox_KeyDown" />

                            <StackPanel x:Name="AgentApiSection" Visibility="Collapsed" Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Account" Style="{StaticResource SectionHeaderStyle}" />
                                    <HyperlinkButton Grid.Column="1" Content="Manage accounts" VerticalAlignment="Center"
                                                     FontSize="12" Click="AccountsCrumb_Click" />
                                </Grid>
                                <RadioButtons x:Name="AgentApiChoices" SelectionChanged="AgentApiChoices_SelectionChanged"
                                              AutomationProperties.Name="Account" />
                                <TextBlock x:Name="AgentApiNote" Visibility="Collapsed" Style="{StaticResource NoteTextStyle}" />
                                <InfoBar x:Name="AgentApiOffer" IsOpen="False" Severity="Informational" IsClosable="True">
                                    <InfoBar.ActionButton>
                                        <Button x:Name="AgentApiOfferButton" Content="Use it" Click="AgentApiOffer_Click" />
                                    </InfoBar.ActionButton>
                                </InfoBar>
                            </StackPanel>

                            <StackPanel x:Name="AiderSettings" Visibility="Collapsed">
                                <TextBlock Text="Model" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Margin="0,0,0,8" Style="{StaticResource NoteTextStyle}"
                                           Text="Optional. Agent Dock adds --model when it starts Aider. Choose its API key under Account above; set other Aider settings in Aider itself. Duplicate this entry to keep another model ready." />
                                <TextBox x:Name="AiderModelBox" Margin="0,0,0,16" Header="Model name" PlaceholderText="anthropic/claude-sonnet-4"
                                         AutomationProperties.Name="Aider model name" AutomationProperties.HelpText="Optional Aider model name. Agent Dock starts Aider with this model."
                                         LostFocus="AiderModelBox_LostFocus" KeyDown="EditorBox_KeyDown" />
                                <TextBlock Text="Find a model" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Margin="0,0,0,8" Style="{StaticResource NoteTextStyle}"
                                           Text="Searches this PC's Aider model catalogue. It can include models your provider account cannot use." />
                                <Grid Margin="0,0,0,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="AiderModelQueryBox" PlaceholderText="Provider or model, such as openai/ or claude"
                                             AutomationProperties.Name="Find an Aider model" KeyDown="AiderModelQueryBox_KeyDown" />
                                    <Button x:Name="FindAiderModelsButton" Grid.Column="1" Content="Search" Click="FindAiderModels_Click" />
                                </Grid>
                                <ProgressRing x:Name="AiderModelProgress" Margin="0,4" Width="20" Height="20" HorizontalAlignment="Left" Visibility="Collapsed"
                                              IsActive="False" AutomationProperties.Name="Searching Aider models" />
                                <TextBlock x:Name="AiderModelSearchNote" Margin="0,4,0,4" Style="{StaticResource NoteTextStyle}" />
                                <ListView x:Name="AiderModelResults" Margin="-8,0,-8,16" MaxHeight="180" Visibility="Collapsed"
                                          SelectionChanged="AiderModelResults_SelectionChanged" AutomationProperties.Name="Aider model search results" />
                            </StackPanel>
                            <TextBox x:Name="AgentArgumentsBox" Header="Arguments" LostFocus="AgentArgumentsBox_LostFocus" KeyDown="EditorBox_KeyDown" />
                            <TextBlock x:Name="AgentCommandText" IsTextSelectionEnabled="True" Style="{StaticResource NoteTextStyle}" />
                        </StackPanel>

                        <Expander x:Name="AgentEnvSection" Margin="0,16,0,0"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <StackPanel Padding="0,6">
                                    <TextBlock Text="Environment variables" />
                                    <TextBlock x:Name="AgentEnvSummary" Style="{StaticResource NoteTextStyle}" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock x:Name="AgentEnvNote" Margin="0,0,0,8" Style="{StaticResource NoteTextStyle}" />
                                <StackPanel x:Name="AgentEnvRows" Margin="0,0,0,4" Spacing="2" />
                                <Grid Margin="0,4,0,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="EnvNameBox" PlaceholderText="Name" AutomationProperties.Name="Variable name"
                                             KeyDown="EnvBox_KeyDown" />
                                    <TextBox x:Name="EnvValueBox" Grid.Column="1" PlaceholderText="Value" AutomationProperties.Name="Variable value"
                                             KeyDown="EnvBox_KeyDown" />
                                    <Button Grid.Column="2" Width="36" Height="32" Padding="0" Click="AddEnv_Click"
                                            ToolTipService.ToolTip="Add variable" AutomationProperties.Name="Add variable">
                                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <TextBlock Text="In your list" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,8" />
                        <TextBlock Text="Drag agents in the left list to change their order."
                                   Margin="0,0,0,8" Style="{StaticResource NoteTextStyle}" />
                        <StackPanel Spacing="2">
                            <Button Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="DuplicateAgent_Click"
                                    AutomationProperties.HelpText="A second copy with its own name and variables, e.g. for another account.">
                                <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8C8;" FontSize="16" Width="24" /><TextBlock Text="Duplicate" /></StackPanel>
                            </Button>
                            <Button Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE74D;" FontSize="16" Width="24" /><TextBlock Text="Remove" /></StackPanel>
                                <Button.Flyout>
                                    <Flyout x:Name="RemoveAgentFlyout">
                                        <StackPanel Spacing="12" MaxWidth="260">
                                            <TextBlock x:Name="RemoveAgentText" TextWrapping="Wrap" />
                                            <Button Content="Remove" Style="{StaticResource AccentButtonStyle}" Click="RemoveAgent_Click" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="GrokSettings" Visibility="Collapsed">
                        <TextBlock Text="Usage limits" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Margin="0,0,0,16" Style="{StaticResource NoteTextStyle}"
                                   Text="Grok Build's usage comes from grok.com, using Grok Build's own sign-in. To switch accounts, sign in again in Grok Build. This is not a published xAI API, and it can stop working." />
                    </StackPanel>
                    <StackPanel x:Name="CursorSettings" Visibility="Collapsed">
                        <TextBlock Text="Usage limits" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Margin="0,0,0,16" Style="{StaticResource NoteTextStyle}"
                                   Text="Cursor's usage comes from cursor.com, using Cursor CLI's sign-in, for both the CLI and the desktop app. To switch accounts, sign in again in Cursor CLI. This is not a published Cursor API, and it can stop working." />
                    </StackPanel>
                    <StackPanel x:Name="KiroSettings" Visibility="Collapsed">
                        <TextBlock Text="Usage limits" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Margin="0,0,0,16" Style="{StaticResource NoteTextStyle}"
                                   Text="Kiro's monthly credits come from Kiro CLI itself (kiro-cli chat /usage), using Kiro CLI's own sign-in. To switch accounts, sign in again with kiro-cli login. Agent Dock never reads a token." />
                    </StackPanel>
                    <StackPanel x:Name="AntigravitySettings" Visibility="Collapsed">
                        <TextBlock Text="Usage limits" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Margin="0,0,0,16" Style="{StaticResource NoteTextStyle}"
                                   Text="Antigravity's weekly limits come from Antigravity CLI itself (agy -p /usage), using Antigravity's own sign-in. It answers with one week per model family. To switch accounts, sign in again in Antigravity. Agent Dock never reads a token." />
                    </StackPanel>
                    <StackPanel x:Name="AmpSettings" Visibility="Collapsed">
                        <TextBlock Text="Usage limits" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Margin="0,0,0,16" Style="{StaticResource NoteTextStyle}"
                                   Text="Amp's credit balance comes from Amp CLI itself (amp usage), using Amp CLI's own sign-in. To switch accounts, sign in again with amp login. Agent Dock never reads a token." />
                    </StackPanel>
                    <StackPanel x:Name="CopilotSettings" Visibility="Collapsed">
                        <TextBlock Text="Usage limits" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Margin="0,0,0,16" Style="{StaticResource NoteTextStyle}"
                                   Text="GitHub Copilot's AI credits come from GitHub, using the GitHub CLI's sign-in (gh), for both Copilot CLI and the desktop app. To switch accounts, sign in again with gh auth login. This is not a published GitHub API, and it can stop working." />
                        <StackPanel x:Name="CopilotFolderSection">
                            <TextBlock Text="Working folder" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock x:Name="CopilotFolderNote" Margin="0,0,0,16" Style="{StaticResource NoteTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="FreebuffSettings" Visibility="Collapsed">
                        <TextBlock Text="Usage limits" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Margin="0,0,0,16" Style="{StaticResource NoteTextStyle}"
                                   Text="Freebuff's daily hours and sessions come from Freebuff's own session endpoint, signed in as Freebuff CLI is (freebuff login), for both the CLI and the desktop app. This is not a published API, and it can stop working." />
                    </StackPanel>
                    <StackPanel x:Name="ClaudeSettings" Visibility="Collapsed">
                        <TextBlock Text="Usage limits" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock x:Name="ClaudeUsageIntro" Margin="0,0,0,4" Style="{StaticResource NoteTextStyle}"
                                   Text="How Agent Dock finds out how much of your plan's session and weekly limits you've used, for the drawer beside Claude Code." />
                        <RadioButtons x:Name="ClaudeUsageSourceButtons" Margin="0,0,0,12"
                                      SelectionChanged="ClaudeUsageSource_SelectionChanged"
                                      AutomationProperties.Name="How to check Claude usage limits"
                                      AutomationProperties.HelpText="How Agent Dock finds out how much of your plan's session and weekly limits you've used, for the drawer beside Claude Code.">
                            <RadioButton AutomationProperties.Name="Read them from the status line"
                                         AutomationProperties.HelpText="Claude Code reports your limits while a session is running.">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Read them from the status line" />
                                    <TextBlock Text="Claude Code reports your limits while a session is running." Style="{StaticResource NoteTextStyle}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="Ask Claude for them directly"
                                         AutomationProperties.HelpText="Checks your limits when you open the flyout, using the Claude Code sign-in already on this PC. This is not a published Anthropic API, and it can stop working.">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Ask Claude for them directly" />
                                    <TextBlock Text="Checks your limits when you open the flyout, using the Claude Code sign-in already on this PC. This is not a published Anthropic API, and it can stop working."
                                               Style="{StaticResource NoteTextStyle}" />
                                </StackPanel>
                            </RadioButton>
                        </RadioButtons>
                    </StackPanel>

                    </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
