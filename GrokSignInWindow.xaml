<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AgentDock.GrokSignInWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sign in to grok.com">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- What this is for; replaced with progress and problems as the page loads. -->
        <TextBlock x:Name="StatusLine" Margin="16,12,16,12" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Sign in to grok.com so Agent Dock can show your Grok Build usage. Agent Dock keeps this sign-in to itself, separate from your browser." />

        <!-- grok.com in Agent Dock's own WebView2 profile (GrokUsage.DataFolder). -->
        <WebView2 x:Name="Browser" Grid.Row="1" />
    </Grid>
</Window>
