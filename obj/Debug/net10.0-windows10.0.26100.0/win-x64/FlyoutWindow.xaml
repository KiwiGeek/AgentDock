<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AgentDock.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AgentDock.Models"
    Title="Agent Dock">

    <!-- Acrylic: the material Windows 11 uses for its own flyouts. -->
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:ConnectionId='2' x:Name="Root"                                     >
        <Grid.RenderTransform>
            <TranslateTransform x:ConnectionId='3' x:Name="RootTranslate" />
        </Grid.RenderTransform>

        <Grid.Resources>
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="16,12,16,4" />
            </Style>

            <DataTemplate x:Key="AgentTemplate"                              >
                <Grid x:ConnectionId='5' Padding="0,6" ColumnSpacing="12"                               >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon x:ConnectionId='6'                        FontSize="20"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                                 />
                    <Image x:ConnectionId='7'                                     Width="28" Height="28" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:ConnectionId='10'                      TextTrimming="CharacterEllipsis" />
                        <TextBlock x:ConnectionId='11'                          Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Number key that launches this agent -->
                    <Border x:ConnectionId='8' Grid.Column="2" MinWidth="22" Height="22" Padding="6,0" CornerRadius="4"
                            VerticalAlignment="Center" BorderThickness="1"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                                                 >
                        <TextBlock x:ConnectionId='9'                                       FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Border>
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Working folder -->
        <StackPanel Margin="16,16,16,8" Spacing="6">
            <TextBlock Text="Working folder" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:ConnectionId='20' x:Name="FolderBox" HorizontalAlignment="Stretch"
                                                                       
                          AutomationProperties.Name="Working folder">
                    <ComboBox.ItemTemplate>
                        <DataTemplate                               >
                            <TextBlock x:ConnectionId='23' TextTrimming="CharacterEllipsis"                                       >
                                <Run x:ConnectionId='24'                      />
                                <Run x:ConnectionId='25'                        FontSize="12"
                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:ConnectionId='21' Grid.Column="1" Height="32"                     
                        ToolTipService.ToolTip="Choose folder" AutomationProperties.Name="Choose folder">
                    <FontIcon Glyph="&#xE838;" FontSize="16" />
                </Button>
            </Grid>
        </StackPanel>

        <!-- Agents -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="0,0,0,8">
                <TextBlock x:ConnectionId='15' x:Name="CliHeader" Text="Command line" Style="{StaticResource SectionHeaderStyle}" />
                <ListView x:ConnectionId='16' x:Name="CliList" Margin="4,0" SelectionMode="None" IsItemClickEnabled="True"
                                                                                          
                          ItemTemplate="{StaticResource AgentTemplate}"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="Command line agents" />

                <TextBlock x:ConnectionId='17' x:Name="DesktopHeader" Text="Desktop apps" Style="{StaticResource SectionHeaderStyle}" />
                <ListView x:ConnectionId='18' x:Name="DesktopList" Margin="4,0" SelectionMode="None" IsItemClickEnabled="True"
                                                                                          
                          ItemTemplate="{StaticResource AgentTemplate}"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="Desktop apps" />

                <TextBlock x:ConnectionId='19' x:Name="EmptyText" Visibility="Collapsed" Margin="16,12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="No agents found. Install a CLI such as Claude Code, or add one under Edit agents." />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="16,6,8,6" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
            <Grid ColumnSpacing="4">
                <Grid.Resources>
                    <!-- Lightweight styling: borderless buttons, like the Start menu's footer. -->
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Default">
                                <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Light">
                                <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:ConnectionId='12' x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:ConnectionId='13' Grid.Column="1" Width="36" Height="32" Padding="0"                        
                        ToolTipService.ToolTip="Open terminal in this folder"
                        AutomationProperties.Name="Open terminal in this folder">
                    <FontIcon Glyph="&#xE756;" FontSize="16" />
                </Button>
                <Button x:ConnectionId='14' Grid.Column="2" Width="36" Height="32" Padding="0"                         
                        ToolTipService.ToolTip="Edit agents" AutomationProperties.Name="Edit agents">
                    <FontIcon Glyph="&#xE70F;" FontSize="16" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>

